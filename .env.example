POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!

APP_ENV=dev
APP_DEBUG=1
DATABASE_URL=postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8
CORS_ALLOW_ORIGIN=http://localhost:5173
SIMULATION_MODE=true
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_JWT_SECRET=dev-mercure-secret
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=bjoernb/gemma4-31b-think:latest
AI_PROVIDER=ollama
DEFAULT_URI=http://localhost
MAILBOX_ENCRYPTION_KEY=your-secret-key-here

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Azure OAuth (portal.azure.com > App registrations)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
